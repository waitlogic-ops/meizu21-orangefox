# SPDX-License-Identifier: Apache-2.0
# Stock USB setup adapted from evidence/stock-init.recovery.qcom.rc.
import /init.recovery.meizu21-services.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a600000.dwc3
    write /sys/class/backlight/panel0-backlight/brightness 1024

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode 2
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice} 2
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

on boot
    # Module loading remains the job of the unchanged stock vendor ramdisk.
    chmod 0660 /dev/aac_richtap_dev
    chown system input /dev/aac_richtap_dev
    start vendor.boot-qti

# The stock QSEE listener opens this partition; wait for ueventd first.
on fs
    wait /dev/block/bootdevice/by-name/ssd 10
    start vendor.qseecomd

# The source hook signals only after reading the installed OS properties.
on property:vendor.sys.listeners.registered=true && property:meizu21.crypto.props_ready=1
    start vendor.keymint-qti
    start vendor.gatekeeper_default

# Module loading publishes this before the recovery UI is started.
on property:twrp.modules.loaded=true
    chmod 0660 /dev/aac_richtap_dev
    chown system input /dev/aac_richtap_dev
    start vendor.qti.vibrator
