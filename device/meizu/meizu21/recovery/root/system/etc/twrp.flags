/system erofs system flags=display="System";backup=1
/vendor erofs vendor flags=display="Vendor";backup=1
/odm erofs odm flags=display="ODM";backup=1;mounttodecrypt
/vendor/firmware_mnt vfat /dev/block/bootdevice/by-name/modem flags=mounttodecrypt
/metadata f2fs /dev/block/bootdevice/by-name/metadata flags=display="Metadata";backup=1;mounttodecrypt
/data f2fs /dev/block/bootdevice/by-name/userdata flags=display="Data";backup=1;userdataencryptbackup=1
/recovery emmc /dev/block/by-name/recovery flags=display="Recovery";backup=1;flashimg=1
